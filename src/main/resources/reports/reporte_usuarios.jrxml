<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="reporte_usuarios"
              pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30"
              whenNoDataType="AllSectionsNoDetail">

    <parameter name="fechaGeneracion" class="java.lang.String"/>
    <parameter name="totalUsuarios" class="java.lang.Integer"/>

    <field name="idUsuario" class="java.lang.Integer"/>
    <field name="nombreCompleto" class="java.lang.String"/>
    <field name="dni" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>
    <field name="rol" class="java.lang.String"/>
    <field name="fechaRegistro" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>

    <title>
        <band height="72">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="52" backcolor="#F5F0E6"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="12" y="6" width="220" height="24" forecolor="#3E352F"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Bibliot.]]></text>
            </staticText>
            <staticText>
                <reportElement x="12" y="30" width="280" height="16" forecolor="#6B5E53"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10"/>
                </textElement>
                <text><![CDATA[Reporte General de Usuarios Registrados]]></text>
            </staticText>
            <textField>
                <reportElement x="320" y="10" width="203" height="14" forecolor="#6B5E53"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Generado: " + $P{fechaGeneracion}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="320" y="28" width="203" height="16" forecolor="#3E352F"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total de usuarios: " + $P{totalUsuarios}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="60" width="535" height="1" forecolor="#D9D2C5"/>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="26">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="30" height="24" forecolor="#FFFFFF" backcolor="#6B5E53"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="30" y="0" width="130" height="24" forecolor="#FFFFFF" backcolor="#6B5E53"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Nombre completo]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="160" y="0" width="60" height="24" forecolor="#FFFFFF" backcolor="#6B5E53"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[DNI]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="220" y="0" width="140" height="24" forecolor="#FFFFFF" backcolor="#6B5E53"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Correo]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="360" y="0" width="65" height="24" forecolor="#FFFFFF" backcolor="#6B5E53"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Rol]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="425" y="0" width="58" height="24" forecolor="#FFFFFF" backcolor="#6B5E53"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Registro]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="483" y="0" width="52" height="24" forecolor="#FFFFFF" backcolor="#6B5E53"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Estado]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22" splitType="Stretch">
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement stretchType="ElementGroupHeight" x="0" y="0" width="30" height="20"/>
                <box leftPadding="4" rightPadding="4" topPadding="3" bottomPadding="3">
                    <bottomPen lineWidth="0.5" lineColor="#E0D8CC"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{idUsuario}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement stretchType="ElementGroupHeight" x="30" y="0" width="130" height="20"/>
                <box leftPadding="4" rightPadding="4" topPadding="3" bottomPadding="3">
                    <bottomPen lineWidth="0.5" lineColor="#E0D8CC"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nombreCompleto}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement stretchType="ElementGroupHeight" x="160" y="0" width="60" height="20"/>
                <box leftPadding="4" rightPadding="4" topPadding="3" bottomPadding="3">
                    <bottomPen lineWidth="0.5" lineColor="#E0D8CC"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{dni}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement stretchType="ElementGroupHeight" x="220" y="0" width="140" height="20"/>
                <box leftPadding="4" rightPadding="4" topPadding="3" bottomPadding="3">
                    <bottomPen lineWidth="0.5" lineColor="#E0D8CC"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{email}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement stretchType="ElementGroupHeight" x="360" y="0" width="65" height="20"/>
                <box leftPadding="4" rightPadding="4" topPadding="3" bottomPadding="3">
                    <bottomPen lineWidth="0.5" lineColor="#E0D8CC"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{rol}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement stretchType="ElementGroupHeight" x="425" y="0" width="58" height="20"/>
                <box leftPadding="4" rightPadding="4" topPadding="3" bottomPadding="3">
                    <bottomPen lineWidth="0.5" lineColor="#E0D8CC"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{fechaRegistro}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement stretchType="ElementGroupHeight" x="483" y="0" width="52" height="20"/>
                <box leftPadding="4" rightPadding="4" topPadding="3" bottomPadding="3">
                    <bottomPen lineWidth="0.5" lineColor="#E0D8CC"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="24">
            <staticText>
                <reportElement x="0" y="6" width="380" height="14" forecolor="#7A7067"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <text><![CDATA[BIBLIOT - Centro de Recursos Bibliográficos y Digitales | Arequipa]]></text>
            </staticText>
            <textField>
                <reportElement x="435" y="6" width="100" height="14" forecolor="#7A7067"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>